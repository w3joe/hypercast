# Copy to deploy/demo.env (ignored by git). Never use VITE_ for secrets.
DEMO_PUBLIC_ORIGIN=https://your-hypercast-project.vercel.app
# Generate locally with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DEMO_SESSION_SECRET=
# A verified sending domain is required for sending to public visitors.
DEMO_EMAIL_FROM=Hypercast <demo@your-domain.example>
RESEND_API_KEY=
